<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1" alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" fx:controller="com.mycompany.calendario.PrimaryController">
   <children>
      <Label text="Fecha de nacimiento (d/m/aaaa)" />
      <TextField fx:id="txtFecha" promptText="15/3/2005" />
      <Button text="Calcular" onAction="#calcular" />
      <Button text="Limpiar" onAction="#limpiar" />
      <Label fx:id="lblResultado" />
      <Button fx:id="primaryButton" text="Switch to Secondary View" onAction="#switchToSecondary" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>